# Student and recruiter buttons default to the public seed accounts.
# Configure these only for dedicated demo accounts; Vite variables are public in the browser bundle.
VITE_DEMO_STUDENT_EMAIL=
VITE_DEMO_STUDENT_PASSWORD=
VITE_DEMO_RECRUITER_EMAIL=
VITE_DEMO_RECRUITER_PASSWORD=
# Admin autofill is intentionally disabled unless a dedicated demo admin is configured.
# Never use the major admin's real account or password here.
VITE_DEMO_ADMIN_EMAIL=
VITE_DEMO_ADMIN_PASSWORD=
